@misc{Neumann.Hug2023,
 abstract = {Die Präsentation des Text+ Partners Berlin-Brandenburgischen Akademie der Wissenschaften wurde beim Workshop "Wohin damit? Storing and reusing my language data" am 22. Juni 2023 in Mannheim gehalten. Die Präsentation wurde im Kontext der Arbeit des Vereins Nationale Forschungsdateninfrastruktur (NFDI) e.V. verfasst. NFDI wird von der Bundesrepublik Deutschland und den 16 Bundesländern finanziert, und das Konsortium Text+ wird gefördert durch die Deutsche Forschungsgemeinschaft (DFG) – Projektnummer 460033370. Die Autor:innen bedanken sich für die Förderung sowie Unterstützung. Ein Dank geht außerdem an alle Einrichtungen und Akteur:innen, die sich für den Verein und dessen Ziele engagieren},
 author = {Neumann, Marko and Hug, Marius},
 copyright = {Creative Commons Attribution 4.0 International, Open Access},
