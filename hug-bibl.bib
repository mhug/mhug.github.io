@techreport{draxler_bericht_2023,
	type = {Project deliverable},
	title = {Bericht über die {Referenzimplementierung} der ortsverteilten {Infrastruktur} in {Collections}},
	copyright = {CC-BY 4.0, Open Access},
	url = {https://zenodo.org/doi/10.5281/zenodo.12759059},
	abstract = {Das NFDI-Konsortium Text+ stellt eine verteilte Infrastruktur für die Archivierung und Bereitstellung von sprach- und textbasierten Forschungsdaten zur Verfügung. An der Datendomäne Collections beispielsweise sind derzeit elf Datenzentren an verschiedenen Standorten beteiligt. Während der Zugriff auf die jeweiligen Daten in dieser dezentral organisierten Infrastruktur eine Herausforderung darstellt, war und ist der Aufbau eines gemeinsamen „Datensilos“ – in das die Zentren ihre Sammlungen überführen – aus verschiedenen Gründen kein gangbarer Weg.

Das vorliegende Dokument legt diese Gründe anhand konkreter Beispiele detailliert dar und beschreibt die Zugriffsmöglichkeiten auf Daten und Dienste, die die ortsverteilte Infrastruktur von Text+ bietet.},
	language = {ger},
	number = {C1.2},
	urldate = {2024-07-25},
	author = {Draxler, Christoph and Ecker, Jennifer and Genêt, Philippe and Gradl, Tobias and Hemmer, Alina and Hug, Marius and Körner, Erik and Kurzawe, Daniel and Trippel, Thorsten},
	month = sep,
	year = {2023},
	keywords = {infrastructure, TA: Collections, FABIO: report document},
	pages = {14},
}

@techreport{genet_konzept_2023,
	type = {Project milestone},
	title = {Konzept und prototypische {Implementierung} beispielhafter {Ressourcen}},
	copyright = {CC-BY 4.0, Open Access},
	url = {https://zenodo.org/doi/10.5281/zenodo.12771255},
	abstract = {Ziel der Text+ Infrastruktur im Hinblick auf die Datendomäne Collections ist es, die Sammlungen der beteiligten Partnerinstitutionen über ein zentrales Webportal auffindbar und durchsuchbar zu machen, ohne die Sammlungen dabei in ein zentrales Datensilo zu überführen, sondern sie ortsverteilt in ihren jeweiligen Heimatrepositorien zu belassen und auf unterschiedlichen Ebenen zu vernetzen.

Dieses Dokument beschreibt die Werkzeuge, mit denen dieses Ziel erreicht werden soll, sowie die beispielhaften Ressourcen, die für die prototypische Umsetzung herangezogen werden sollen – einschließlich des Metadatenschemas zur Beschreibung von Sammlungen in Text+.},
